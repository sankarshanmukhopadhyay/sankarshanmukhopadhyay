{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sankarshanmukhopadhyay.github.io/sankarshanmukhopadhyay/schemas/portfolio-work-queue.schema.json",
  "title": "Portfolio Work Queue",
  "type": "object",
  "required": ["schema_version", "generated_at", "authority", "candidates"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "generated_at": {"type": "string"},
    "authority": {
      "type": "object",
      "required": ["scope_source", "statement"],
      "properties": {
        "scope_source": {"type": "string"},
        "statement": {"type": "string"}
      },
      "additionalProperties": false
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id","repository","title","url","source_type","state","lane","change","dependency","evidence","effort","complexity","confidence","project_goal_impact","priority","leverage","rationale"],
        "properties": {
          "id": {"type":"string"},
          "repository": {"type":"string"},
          "title": {"type":"string"},
          "url": {"type":"string","format":"uri"},
          "source_type": {"enum":["issue","pull-request"]},
          "state": {"enum":["ready","in_progress","waiting_internal","waiting_external","needs_judgment","evidence_required","superseded","stale_candidate","completed"]},
          "lane": {"enum":["strategic","maintenance","planning"]},
          "change": {
            "type":"object",
            "required":["type","scope","breaking","typed","classification_source"],
            "properties": {
              "type":{"type":"string"},
              "scope":{"type":["string","null"]},
              "breaking":{"type":"boolean"},
              "typed":{"type":"boolean"},
              "classification_source":{"enum":["title","inferred"]}
            },
            "additionalProperties": false
          },
          "dependency": {
            "type":"object",
            "required":["kind","source","condition"],
            "properties": {
              "kind":{"enum":["none","internal","external"]},
              "source":{"type":["string","null"]},
              "condition":{"type":["string","null"]}
            },
            "additionalProperties": false
          },
          "evidence": {
            "type":"object",
            "required":["state","last_verified_at","source_updated_at"],
            "properties": {
              "state":{"enum":["unverified","partially_verified","verified","execution_evidence_pending","complete"]},
              "last_verified_at":{"type":"string"},
              "source_updated_at":{"type":["string","null"]}
            },
            "additionalProperties": false
          },
          "effort": {
            "type":"object",
            "required":["bucket","minutes"],
            "properties":{"bucket":{"type":"string"},"minutes":{"type":"integer","minimum":1}},
            "additionalProperties": false
          },
          "complexity": {"enum":["low","medium","high","consequential"]},
          "confidence": {"enum":["low","medium","high"]},
          "project_goal_impact": {"enum":["none","low","medium","high","very-high"]},
          "priority": {"type":"number"},
          "leverage": {"type":"number"},
          "rationale": {"type":"array","items":{"type":"string"}},
          "labels": {"type":"array","items":{"type":"string"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
