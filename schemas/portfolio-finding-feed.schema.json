{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sankarshanmukhopadhyay.github.io/sankarshanmukhopadhyay/schemas/portfolio-finding-feed.schema.json",
  "title": "Portfolio assurance development finding feed",
  "type": "object",
  "required": ["$schema", "schema_version", "generated_at", "repository", "source", "finding_count", "findings"],
  "properties": {
    "$schema": {"type": "string", "format": "uri"},
    "schema_version": {"const": "1.0"},
    "generated_at": {"type": "string", "format": "date-time"},
    "repository": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "required": ["monitor", "dashboard", "latest_report"],
      "properties": {
        "monitor": {"type": "string", "format": "uri"},
        "dashboard": {"type": "string", "format": "uri"},
        "latest_report": {"type": "string", "format": "uri"}
      },
      "additionalProperties": false
    },
    "finding_count": {"type": "integer", "minimum": 0},
    "findings": {
      "type": "array",
      "items": {"$ref": "portfolio-finding.schema.json"}
    }
  },
  "additionalProperties": false
}
